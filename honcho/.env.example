#
# Honcho .env for the clermes bundle.
#
# Defaults wire deriver + embeddings to a local Ollama instance reachable
# at host.docker.internal:11434. Containers reach the host through the
# extra_hosts entry in docker-compose.yml. If your Ollama runs on a
# different host, set the BASE_URL values accordingly.
#
# To switch to a hosted provider (OpenAI, Anthropic, Groq, etc.), drop
# the OVERRIDES__BASE_URL lines and add the relevant API key.

# ---------------------------------------------------------------------
# Honcho version pin
# ---------------------------------------------------------------------

# Pin a Honcho release. Update both this and the docker-compose default
# in lockstep. Override per-environment by exporting HONCHO_REF before
# `docker compose up`.
HONCHO_REF=v3.0.7

# ---------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------

# Local-only install. Disable bearer-token auth so curl + the Hermes /
# Claude Code plugins do not need an API key. If you expose this Honcho
# instance beyond localhost, set this to true and configure tokens.
AUTH_USE_AUTH=false

# ---------------------------------------------------------------------
# Embeddings: local via Ollama
# ---------------------------------------------------------------------

# nomic-embed-text emits 768-dim vectors. If you swap models, update the
# dimension to match.
EMBEDDING_VECTOR_DIMENSIONS=768
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=ollama

# ---------------------------------------------------------------------
# Deriver: local via Ollama
# ---------------------------------------------------------------------

# Qwen 3.5 works well for the single structured-output call per batch
# that the deriver performs.
#
# IMPORTANT: think:false disables Qwen's extended thinking mode. With
# thinking on, the deriver gets a reasoning block instead of strict JSON
# and the batch fails with "Repair failed: empty JSON". Leave think:false
# unless you have switched to a model that does not have this mode.
DERIVER_MODEL_CONFIG__MODEL=qwen3.5:latest
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:11434/v1
DERIVER_MODEL_CONFIG__OVERRIDES__EXTRA_BODY={"think": false}

# ---------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------

CACHE_ENABLED=true
